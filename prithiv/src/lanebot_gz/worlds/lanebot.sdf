    </model>

    <model name="ego">
      <pose>0 0 0 0 0 0</pose>
      <link name="base_link">
        <gravity>false</gravity>
        <inertial><mass>1500</mass></inertial>
        <visual name="body">
          <pose>0 0 0.75 0 0 0</pose>
          <geometry><box><size>4.6 1.9 0.9</size></box></geometry>
          <material><ambient>0.1 0.3 0.8 1</ambient><diffuse>0.1 0.3 0.8 1</diffuse></material>
        </visual>
        <visual name="cabin">
          <pose>-0.3 0 1.45 0 0 0</pose>
          <geometry><box><size>2.4 1.7 0.6</size></box></geometry>
          <material><ambient>0.2 0.2 0.25 1</ambient><diffuse>0.2 0.2 0.25 1</diffuse></material>
        </visual>
        
        <visual name="wheel_fl">
          <pose>1.45 0.85 0.35 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.35</radius><length>0.25</length></cylinder></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
        </visual>
        <visual name="wheel_fr">
          <pose>1.45 -0.85 0.35 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.35</radius><length>0.25</length></cylinder></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
        </visual>
        <visual name="wheel_rl">
          <pose>-1.45 0.85 0.35 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.35</radius><length>0.25</length></cylinder></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
        </visual>
        <visual name="wheel_rr">
          <pose>-1.45 -0.85 0.35 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.35</radius><length>0.25</length></cylinder></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
        </visual>
        <!-- 32-beam lidar on the roof, 2.4 m up, like the CARLA example car -->
        <sensor name="lidar" type="gpu_lidar">
          <pose>0 0 2.4 0 0 0</pose>
          <topic>lidar</topic>
          <update_rate>10</update_rate>
          <lidar>
            <scan>
              <horizontal><samples>1024</samples><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal>
              <vertical><samples>32</samples><min_angle>-0.4677</min_angle><max_angle>0.0349</max_angle></vertical>
            </scan>
            <range><min>0.5</min><max>50</max><resolution>0.01</resolution></range>
          </lidar>
          <always_on>1</always_on>
        </sensor>
        <!-- front camera, for camera-based lane detection later -->
        <sensor name="rgb_front" type="camera">
          <pose>2.0 0 2.0 0 0 0</pose>
          <topic>rgb_front/image</topic>
          <update_rate>10</update_rate>
          <camera><horizontal_fov>1.5708</horizontal_fov><image><width>800</width><height>600</height></image></camera>
          <always_on>1</always_on>
        </sensor>
        <!-- chase camera, for watching -->
        <sensor name="rgb_view" type="camera">
          <pose>-6.5 0 3.2 0 0.30 0</pose>
          <topic>rgb_view/image</topic>
          <update_rate>15</update_rate>
          <camera><horizontal_fov>1.5708</horizontal_fov><image><width>800</width><height>600</height></image></camera>
          <always_on>1</always_on>
        </sensor>
      </link>
      <!-- moves the car with the speed and turn rate we send on /model/ego/cmd_vel -->
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl"/>
      <!-- publishes where the car is on /model/ego/odometry -->
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <odom_frame>map</odom_frame>
        <robot_base_frame>ego</robot_base_frame>
        <odom_publish_frequency>20</odom_publish_frequency>
      </plugin>
    </model>
  </world>
</sdf>
